Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Abapassist
Bundle-SymbolicName: com.google.abapassist;singleton:=true
Bundle-Version: 1.1.1.qualifier
Export-Package: com.google.abapassist.views
Import-Package: jakarta.inject;version="[2.0.0,3.0.0)"
Require-Bundle: org.eclipse.ui,
 com.sap.adt.tools.abapsource.ui,
 org.eclipse.ui.workbench.texteditor,
 org.eclipse.text,
