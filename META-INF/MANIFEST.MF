 org.eclipse.core.resources;bundle-version="3.22.0",
 com.sap.adt.communication,
 com.sap.adt.compatibility,
 com.sap.adt.destinations,
 com.sap.adt.destinations.ui,
 com.sap.adt.tools.core,
 com.sap.adt.tools.core.base,
 com.sap.adt.destinations.model,
 org.eclipse.core.runtime;bundle-version="3.32.0",
 com.google.gson,
 jakarta.xml.bind,
 com.fasterxml.jackson.core.jackson-core,
 com.fasterxml.jackson.core.jackson-databind,
 com.sap.adt.tools.core.ui;bundle-version="3.48.1",
 com.sap.adt.util.ui;bundle-version="3.48.0"
Automatic-Module-Name: com.google.abapassist
